{
  "color": {
    "$type": "color",

    "bg": {
      "canvas":         { "$value": "{color.neutral.50}" },
      "surface":        { "$value": "{color.white}" },
      "subtle":         { "$value": "{color.neutral.100}" },
      "accent":         { "$value": "{color.blue.600}" },
      "accent-hover":   { "$value": "{color.blue.700}" },
      "accent-subtle":  { "$value": "{color.blue.50}" },
      "danger":         { "$value": "{color.red.600}" },
      "danger-hover":   { "$value": "{color.red.700}" },
      "danger-subtle":  { "$value": "{color.red.50}" },
      "success-subtle": { "$value": "{color.green.50}" },
      "warning-subtle": { "$value": "{color.amber.50}" },
      "overlay":        { "$value": "#0a0a0a73", "$description": "Dims the page behind modal dialogs (neutral.950 at 45%)." }
    },

    "text": {
      "primary":   { "$value": "{color.neutral.900}" },
      "muted":     { "$value": "{color.neutral.600}" },
      "disabled":  { "$value": "{color.neutral.400}" },
      "accent":    { "$value": "{color.blue.700}" },
      "on-accent": { "$value": "{color.white}" },
      "on-danger": { "$value": "{color.white}" },
      "danger":    { "$value": "{color.red.700}" },
      "success":   { "$value": "{color.green.700}" },
      "warning":   { "$value": "{color.amber.800}" }
    },

    "border": {
      "default": { "$value": "{color.neutral.200}" },
      "strong":  { "$value": "{color.neutral.500}" },
      "focus":   { "$value": "{color.blue.600}" },
      "danger":  { "$value": "{color.red.600}" }
    }
  }
}
