{
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "0ms" },
      "fast":    { "$value": "100ms" },
      "normal":  { "$value": "200ms" },
      "slow":    { "$value": "300ms" },
      "slower":  { "$value": "500ms" }
    },

    "easing": {
      "$type": "cubicBezier",
      "standard":   { "$value": [0.2, 0, 0, 1] },
      "enter":      { "$value": [0, 0, 0.2, 1] },
      "exit":       { "$value": [0.4, 0, 1, 1] },
      "emphasized": { "$value": [0.3, 0, 0, 1.2] }
    }
  }
}
