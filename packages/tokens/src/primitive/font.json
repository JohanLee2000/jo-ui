{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"]
      },
      "mono": {
        "$value": ["JetBrains Mono", "ui-monospace", "Cascadia Code", "Consolas", "monospace"]
      }
    },

    "size": {
      "$type": "dimension",
      "xs":  { "$value": "0.75rem" },
      "sm":  { "$value": "0.875rem" },
      "md":  { "$value": "1rem" },
      "lg":  { "$value": "1.125rem" },
      "xl":  { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" },
      "4xl": { "$value": "2.25rem" }
    },

    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    },

    "line-height": {
      "$type": "number",
      "tight":   { "$value": 1.2 },
      "snug":    { "$value": 1.375 },
      "normal":  { "$value": 1.5 },
      "relaxed": { "$value": 1.625 }
    },

    "letter-spacing": {
      "$type": "dimension",
      "tight":  { "$value": "-0.025em" },
      "normal": { "$value": "0em" },
      "wide":   { "$value": "0.025em" }
    }
  }
}
