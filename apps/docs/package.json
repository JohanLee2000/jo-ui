{
  "name": "@jo-ui/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build-tokens": "pnpm --filter @jo-ui/tokens build",
    "storybook": "pnpm build-tokens && storybook dev -p 6006",
    "build-storybook": "pnpm build-tokens && storybook build",
    "test": "pnpm build-tokens && vitest run",
    "test:visual": "pnpm build-storybook && playwright test -c visual",
    "test:visual:update": "pnpm build-storybook && playwright test -c visual --update-snapshots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jo-ui/tokens": "workspace:*",
    "@jo-ui/ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@jo-ui/tsconfig": "workspace:*",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "playwright": "^1.65.1",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
